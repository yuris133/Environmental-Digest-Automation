@echo off
rem ==== Daily SMMplanner feed run (Task Scheduler: Mon-Fri 10:30) ====
rem NOTE: keep this file ASCII-only (batch parser uses a legacy codepage)
cd /d "C:\Users\Windows\My Ai\market-research-agent"
rem ==== load auth from local (gitignored) env file, same as run-weekly.cmd ====
if exist ".claude\auth-weekly.env" (
  for /f "usebackq delims=" %%a in (".claude\auth-weekly.env") do set "%%a"
)
echo === %date% %time%: daily post run start === >> daily-post-run.log
claude -p "Daily social post for the SMMplanner Reposter. Work only inside this project folder, use only Read/Write/Edit of text files - no shell commands, no binary file copies, no posting anywhere. Step 1: find the latest weekly report - the file in the 'Report' folder with the newest date in its name (pattern YYYY-MM-DD-green-waste-tech-fmcg-weekly-report*.md). Step 2: read 'rss-site/state.json', branch 'added' - it lists posts already prepared or published (fields: guid, file, title, image). Step 3: from the report choose exactly ONE news item that was never used in state.json entries before (match by source URL and headline). Then follow the skill file '.claude/skills/SMMplanner RSS Post/SKILL.md' to prepare one new post: first read one existing JSON file in the 'posts news' folder and reuse its exact schema and key names (including the Russian platform key). Save it as 'posts news/YYYY-MM-DD-<short-english-slug>-social-content.json' (YYYY-MM-DD = today date). Texts in Russian, based strictly on facts from the chosen report item, no invented facts, include a link to the source as in existing files. Do NOT copy any image files. Instead: if an existing related image is available in 'posts/img' or 'digest/img' (jpg, webp or png), note its project-relative path and original file name; otherwise leave the image without a photo. Then update 'rss-site/state.json': append one entry with fields guid (json filename without extension), file ('posts news/<json filename>'), title (post headline), pubDate (today as: Fri, 13 Nov 2026 10:35:00 +0300 - use today real date, compute the weekday name), and then image handling: if a related image is available in 'posts/img' or 'digest/img' (jpg, webp or png), add image (original image file name only) and img_source (the project-relative image path). If NO suitable image exists: add img_prompt (copy the exact value of the post's 'image_prompt' field) and omit image/img_source entirely - the deploy script will generate the photo via fal, attach the enclosure and update the state entry itself. Then update 'rss-site/feed.xml': insert one new <item> at the VERY TOP following the existing item format; per skill rules set pubDate to the same current date-time 'Fri, DD Mon YYYY 10:35:00 +0300' with the real date; add <enclosure> with url 'https://market-research-agent.pages.dev/img/<image name>' ONLY for the entry that has an image; keep maximum 20 items by dropping the oldest at the bottom; other items stay untouched with their existing pubDate. Print a one-line summary of which news item you prepared and whether it has an image. Do not send anything to social networks or email - only local files." >> daily-post-run.log 2>&1
echo === %date% %time%: claude step done === >> daily-post-run.log
rem ==== deploy the updated feed to Cloudflare Pages (also copies images) ====
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "deploy-feed.ps1" >> daily-post-run.log 2>&1
echo === %date% %time%: deploy done === >> daily-post-run.log
rem ==== publish the new post to VK community club242982533: DISABLED 12.11.2026 ====
rem ==== community wall is covered by SMMplanner Reposter (user connected it); ====
rem ==== script kept on disk: publish-vk-group.ps1 (fallback if SMMplanner fails) ====
echo === %date% %time%: daily run finished, exit code %errorlevel% === >> daily-post-run.log
